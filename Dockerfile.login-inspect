FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
WORKDIR /inspect
COPY artifact/wfm-0.6.76-hosted-staging-rc1.tar.gz /tmp/runtime.tgz
COPY ux-overlay/ /source/ux-overlay/
COPY implementation/ui/ /source/implementation-ui/
COPY learning/ui/ /source/learning-ui/
RUN tar -xzf /tmp/runtime.tgz -C /inspect \
 && node -e "const fs=require('fs'),path=require('path');const roots=['/inspect/public','/source'];const needle='payrollActor';let count=0;function walk(dir){for(const entry of fs.readdirSync(dir,{withFileTypes:true})){const p=path.join(dir,entry.name);if(entry.isDirectory())walk(p);else if(/\\.js$/.test(entry.name)){const s=fs.readFileSync(p,'utf8');let at=0;while((at=s.indexOf(needle,at))>=0){count++;const start=Math.max(0,at-1500),end=Math.min(s.length,at+needle.length+1900);console.log('PAYROLL_ACTOR_CONTEXT_'+count+'='+JSON.stringify({file:p,context:s.slice(start,end)}));at+=needle.length;}}}}for(const r of roots)walk(r);console.log('PAYROLL_ACTOR_COUNT='+count);if(!count)process.exit(2)"
CMD ["node","-e","require('http').createServer((req,res)=>{res.statusCode=200;res.end('ok')}).listen(Number(process.env.PORT||3000),'0.0.0.0')"]
