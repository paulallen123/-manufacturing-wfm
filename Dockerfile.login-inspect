FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
WORKDIR /inspect
COPY artifact/wfm-0.6.76-hosted-staging-rc1.tar.gz /tmp/runtime.tgz
COPY ux-overlay/ /source/ux-overlay/
COPY implementation/ui/ /source/implementation-ui/
COPY learning/ui/ /source/learning-ui/
RUN tar -xzf /tmp/runtime.tgz -C /inspect \
 && node -e "const fs=require('fs'),path=require('path');const review='/inspect/public/review-ui.js',src=fs.readFileSync(review,'utf8'),symbols=new Set();for(const re of [/(?:^|\\n)(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\s*=/g,/(?:^|\\n)(?:async\\s+)?function\\s+([A-Za-z_$][\\w$]*)\\s*\\(/g])for(const m of src.matchAll(re))symbols.add(m[1]);const files=[];function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else if(/\\.js$/.test(e.name)&&p!==review)files.push(p)}}for(const r of ['/inspect/public','/source'])walk(r);let shared=0;for(const sym of [...symbols].sort()){const re=new RegExp('\\\\b'+sym.replace(/[$]/g,'\\\\$&')+'\\\\b','g');const refs=[];for(const f of files){const s=fs.readFileSync(f,'utf8'),n=(s.match(re)||[]).length;if(n)refs.push({file:f,count:n});}if(refs.length){shared++;console.log('RETIRED_SHARED_SYMBOL='+JSON.stringify({symbol:sym,refs}));}}console.log('RETIRED_DECLARATIONS='+symbols.size);console.log('RETIRED_SHARED_COUNT='+shared);if(!shared)process.exit(2)"
CMD ["node","-e","require('http').createServer((req,res)=>{res.statusCode=200;res.end('ok')}).listen(Number(process.env.PORT||3000),'0.0.0.0')"]
