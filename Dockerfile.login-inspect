FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
WORKDIR /inspect
COPY artifact/wfm-0.6.76-hosted-staging-rc1.tar.gz /tmp/runtime.tgz
COPY ux-overlay/ /source/ux-overlay/
COPY implementation/ui/ /source/implementation-ui/
COPY learning/ui/ /source/learning-ui/
RUN tar -xzf /tmp/runtime.tgz -C /inspect \
 && node -e "const fs=require('fs'),path=require('path');const review='/inspect/public/review-ui.js',src=fs.readFileSync(review,'utf8');const names=['PR','RF','amendDialog','banner','issueDialog','payrollActor','payrollPageV4','payrollReport','payrollShell'];const files=[];function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else if(/\\.js$/.test(e.name)&&p!==review)files.push(p)}}for(const r of ['/inspect/public','/source'])walk(r);for(const name of names){const decl=[...src.matchAll(new RegExp('(?:^|\\n)(?:const|let|var)\\s+'+name.replace(/[$]/g,'\\$&')+'\\s*=|(?:^|\\n)(?:async\\s+)?function\\s+'+name.replace(/[$]/g,'\\$&')+'\\s*\\(','g'))][0];if(decl){const at=decl.index;console.log('RETIRED_DECL_CONTEXT='+JSON.stringify({symbol:name,context:src.slice(Math.max(0,at-500),Math.min(src.length,at+1800))}));}const re=new RegExp('\\b'+name.replace(/[$]/g,'\\$&')+'\\b','g');for(const f of files){const s=fs.readFileSync(f,'utf8');for(const m of s.matchAll(re)){const at=m.index;console.log('SURVIVING_REF_CONTEXT='+JSON.stringify({symbol:name,file:f,context:s.slice(Math.max(0,at-700),Math.min(s.length,at+1600))}));}}}"
CMD ["node","-e","require('http').createServer((req,res)=>{res.statusCode=200;res.end('ok')}).listen(Number(process.env.PORT||3000),'0.0.0.0')"]
