{
  "schema_version": 1,
  "purpose": "Keep the WFM project operational when OneDrive or Microsoft Graph has transient failures without risking silent overwrites.",
  "master": {
    "name": "workforce management project.docx",
    "identity_rule": "Pin the exact drive/item identity. Filename search is discovery/fallback only, never the normal read/write path.",
    "single_master": true
  },
  "read_strategy": [
    "exact_item",
    "bounded_retry_with_exponential_backoff_and_jitter",
    "fallback_exact_item_recovery",
    "last_known_good_snapshot_read_only"
  ],
  "write_strategy": [
    "read_latest_exact_item_before_merge",
    "validate_expected_version_or_etag",
    "write_exact_item_conditionally_when_adapter_supports_it",
    "queue_delta_on_transient_unavailability",
    "never_claim_remote_success_without_provider_confirmation"
  ],
  "error_policy": {
    "401": "authentication_required_no_hidden_retry_loop",
    "403": "permission_failure_stop",
    "409_412": "concurrent_change_stop_and_reconcile",
    "429": "retry_using_retry_after_when_available",
    "5xx": "retry_then_fallback_then_queue",
    "network": "retry_then_fallback_then_queue"
  },
  "circuit_breaker": {
    "failure_threshold": 4,
    "reset_ms": 30000,
    "open_behavior": "continue non-OneDrive WFM work and retain queued deltas; do not hammer Microsoft"
  },
  "safety": {
    "no_tokens_or_credentials_in_repo": true,
    "no_public_sharing_link": true,
    "no_blind_last_writer_wins": true,
    "snapshots_are_not_authoritative": true,
    "queued_deltas_are_not_reported_as_synced": true
  }
}
