  "tiers": {
    "T0": {
      "name": "Guidance and deterministic self-service",
      "vendor_engineer_required": false,
      "model_may_execute_consequential_actions": false,
      "allowed_terminal_outcomes": ["answered", "safe_abstention"],
      "graduation_requires": [
        "version_bound_knowledge",
        "role_and_permission_bound_answers",
        "grounding_or_citation_for_factual_procedures",
        "adversarial_prompt_tests",
        "safe_abstention"
      ],
      "current_claim": "not_production_proven"
    },
    "T1": {
      "name": "Known deterministic technical recovery",
      "vendor_engineer_required": false,
      "model_may_execute_consequential_actions": false,
      "allowed_terminal_outcomes": ["recovered", "contained", "external_provider_authorisation_required"],
      "allowlisted_action_prefixes": [
        "integration.retry",
        "integration.replay-idempotent",
        "queue.reconcile",
        "worker.restart",
        "cache.rebuild",
        "release.rollback",
        "configuration.restore-drift"
      ],
      "graduation_requires": [
        "same_tenant",
        "reversible_or_idempotent",
        "retained_system_evidence",
        "independent_verification",
        "one_shot_or_bounded_authority",
        "postcondition_reconciliation"
      ],
      "current_claim": "bounded_ci_and_staging_evidence_only"
    },
    "T2": {
      "name": "Autonomous software/config diagnosis and repair",
      "vendor_engineer_required": false,
      "model_may_execute_consequential_actions": false,
      "production_mutation_from_patch_agent": false,
      "allowed_terminal_outcomes": ["verified_candidate_staged", "contained", "safe_abstention"],
      "graduation_requires": [
        "reproducible_failing_test",
        "isolated_patch_worker",
        "independent_read_only_verifier",
        "security_and_dependency_scan",
        "signed_artifact_and_provenance",
        "isolated_staging_replay",
        "canary_or_equivalent_blast_radius_limit",
        "automatic_known_good_rollback"
      ],
      "current_claim": "architecture_and_partial_proofs_only"
    },
    "T3": {
      "name": "Consequential workforce/business state",
      "vendor_engineer_required": false,
      "model_may_execute_consequential_actions": false,
      "allowed_terminal_outcomes": ["customer_authorisation_required", "contained", "recovered"],
      "current_autonomous_mutation_classes": [],
      "graduation_rule": "Each action class graduates separately only after deterministic invariants, compensation/rollback, tenant/value/cardinality caps and independent verification.",
      "current_claim": "zero_engineer_handling_target_not_autonomous_business_authority"
    },
    "T4": {
      "name": "Novel, destructive or security-critical failure",
      "vendor_engineer_required": false,
      "model_may_execute_consequential_actions": false,
      "allowed_terminal_outcomes": ["contained", "rolled_back_to_known_good", "security_or_legal_authority_required", "verified_candidate_staged"],
      "graduation_requires": [
        "automatic_containment",
        "promotion_freeze",
        "credential_or_session_quarantine_when_proven",
        "forensic_evidence_preservation",
        "known_good_rollback_when_schema_safe",
        "novel_patch_forced_back_through_T2"
      ],
      "current_claim": "containment_target_only"
    }
  }
}
