{
  "schema_version": 1,
  "updated": "2026-09-23",
  "principles": {
    "unknown_means_protect_first": true,
    "customer_impact_containment_precedes_root_cause_repair": true,
    "production_experimentation_for_unknown_faults": false,
    "language_model_direct_execution": false,
    "every_resolved_incident_becomes_prevention": true
  },
  "containment_classes": {
    "reflex": "Known deterministic condition; target machine-speed containment, normally sub-second where the affected component permits it.",
    "rapid": "Deterministic containment requiring dependency or state verification; target seconds, not human escalation.",
    "isolate": "Unknown or high-risk condition; immediately block, preserve or degrade safely while autonomous investigation continues."
  },
