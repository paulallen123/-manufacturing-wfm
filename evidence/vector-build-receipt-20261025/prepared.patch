+++ b/scripts/staffology-test-receipt.cjs
@@ -0,0 +1,39 @@
+'use strict';
+// Build diagnostics only. Full TAP remains in the private artifact and is replayed separately.
+const fs = require('node:fs');
+
+function receipt(tap, exitStatus, bytes = Buffer.byteLength(tap)) {
+  if (!/^(0|[1-9][0-9]{0,2})$/.test(String(exitStatus)) || Number(exitStatus) > 255) throw Error('INVALID_TEST_EXIT');
+  const result = { scope: 'STAFFOLOGY_TEST_PROCESS', exitStatus: Number(exitStatus), bytes, totals: {}, failedTestNumbers: [], startup: [] };
+  for (const line of tap.split(/\r?\n/)) {
+    const total = /^# (tests|pass|fail|cancelled|skipped) (\d{1,9})$/.exec(line);
+    if (total) result.totals[total[1]] = Number(total[2]);
+    const failed = /^\s*not ok (\d{1,9})(?:\s|$)/.exec(line);
+    if (failed && result.failedTestNumbers.length < 32) result.failedTestNumbers.push(Number(failed[1]));
+    // Never replay arbitrary error messages, test names, child output, paths or credentials.
+    if (line.includes('canonical server did not become healthy:') && result.startup.length < 8) {
+      const item = {};
+      const phase = /\bphase=(no-health-response|unhealthy-response)(?:;|$)/.exec(line);
+      if (phase) item.phase = phase[1];
+      for (const key of ['attempts', 'elapsedMs', 'lastHealthStatus']) {
+        const value = new RegExp('\\b' + key + '=(none|[0-9]{1,12})(?:;|$)').exec(line);
+        if (value) item[key] = value[1] === 'none' ? null : Number(value[1]);
+      }
+      const code = /\blastProbeError=(none|ECONNREFUSED|ECONNRESET|ETIMEDOUT|ENOTFOUND|UND_ERR_CONNECT_TIMEOUT|AbortError|TypeError|PROBE_ERROR)(?:;|$)/.exec(line);
+      if (code) item.lastProbeError = code[1];
+      result.startup.push(item);
+    }
+  }
+  return result;
+}
+
+if (require.main === module) {
+  try {
+    const tap = fs.readFileSync(process.argv[2], 'utf8');
+    fs.writeSync(2, 'VECTOR_STAFFOLOGY_RECEIPT ' + JSON.stringify(receipt(tap, process.argv[3])) + '\n');
+  } catch {
+    fs.writeSync(2, 'VECTOR_STAFFOLOGY_RECEIPT_UNAVAILABLE\n');
+    process.exitCode = 1;
+  }
+}
+module.exports = { receipt };
