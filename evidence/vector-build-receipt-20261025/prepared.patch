+++ b/scripts/staffology-test-receipt.test.cjs
@@ -0,0 +1,43 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+const { receipt } = require('./staffology-test-receipt.cjs');
+
+test('receipt reports failure and allowlisted startup facts without copying secrets', () => {
+  const tap = 'not ok 7 - SECRET_TEST_NAME\n  error: canonical server did not become healthy: phase=no-health-response; attempts=400; elapsedMs=12000; lastHealthStatus=none; lastProbeError=ECONNREFUSED; output=SECRET_OUTPUT\n# tests 327\n# pass 326\n# fail 1\n# skipped 0\n';
+  const r = receipt(tap, '1');
+  assert.deepEqual(r.failedTestNumbers, [7]);
+  assert.deepEqual(r.totals, { tests: 327, pass: 326, fail: 1, skipped: 0 });
+  assert.deepEqual(r.startup, [{phase:'no-health-response',attempts:400,elapsedMs:12000,lastHealthStatus:null,lastProbeError:'ECONNREFUSED'}]);
+  assert.equal(JSON.stringify(r).includes('SECRET'), false);
+});
+
+test('receipt does not invent a pass from missing or incomplete TAP', () => {
+  const r = receipt('', 0); assert.deepEqual(r.totals, {}); assert.equal(r.exitStatus, 0);
+  assert.deepEqual(receipt('ok 1 - incomplete\n', 137).totals, {});
+  for (const value of ['x', '-1', '256', '01', '1; echo secret']) assert.throws(() => receipt('', value), /INVALID_TEST_EXIT/);
+});
+
+test('receipt limits output and rejects arbitrary diagnostic fields', () => {
+  const r = receipt(('not ok 1 - SECRET\nerror: canonical server did not become healthy: phase=SECRET; lastProbeError=SECRET; output=SECRET\n').repeat(10000), 1);
+  assert.equal(r.failedTestNumbers.length, 32); assert.equal(r.startup.length, 8);
+  assert.equal(JSON.stringify(r).includes('SECRET'), false); assert.ok(JSON.stringify(r).length < 4096);
+});
+
+test('actual shell preserves original exits, private TAP and replay even if receipt fails', t => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'staffology-receipt-'));
+  t.after(() => fs.rmSync(dir, {recursive:true,force:true}));
+  const file = path.join(dir, 'private.tap'), script = path.join(__dirname, 'staffology-test-receipt.cjs');
+  for (const status of [0,1,137]) for (const missing of [false,true]) {
+    const tap = '# tests 1\n# pass ' + (status === 0 ? '1' : '0') + '\n';
+    fs.writeFileSync(file,tap);
+    const run = spawnSync('/bin/sh',['-c','set +e; status="$1"; "$2" "$3" "$4" "$status"; cat "$5"; exit "$status"','sh',String(status),process.execPath,script,missing?path.join(dir,'missing'):file,file],{encoding:'utf8'});
+    assert.equal(run.status,status); assert.equal(run.stdout,tap); assert.equal(fs.readFileSync(file,'utf8'),tap);
+    assert.match(run.stderr, missing?/VECTOR_STAFFOLOGY_RECEIPT_UNAVAILABLE/:/VECTOR_STAFFOLOGY_RECEIPT /);
+    assert.equal(run.stderr.includes(dir),false);
+  }
+});
