# Isolated customer-proof worker; does not contain or modify the frozen WFM runtime.
FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
WORKDIR /proof
COPY scripts/live-isolation-kiosk-proof.mjs /proof/live-isolation-kiosk-proof.mjs
COPY scripts/proof-runner-auth.mjs /proof/proof-runner-auth.mjs
RUN chown -R root:root /proof \
 && find /proof -type d -exec chmod 0555 {} + \
 && find /proof -type f -exec chmod 0444 {} +
USER node
ENV NODE_ENV=staging
CMD ["sh","-lc","node /proof/live-isolation-kiosk-proof.mjs && node -e \"require('http').createServer((req,res)=>{res.statusCode=200;res.setHeader('content-type','text/plain');res.end('proof-pass\\n')}).listen(Number(process.env.PORT||3000),'0.0.0.0')\""]
