'use strict';const test=require('node:test'),assert=require('node:assert/strict');const{createTwinRevision,digest}=require('../../implementation/runtime/implementation-digital-twin.cjs');const{projectSiteOperatingContext}=require('./site-operating-context-projection.cjs');
const at='2026-10-02T00:00:00.000Z',past='2026-01-01T00:00:00.000Z';
const node=(id,type,data={},extra={})=>({id,type,data,source:'fixture://'+id,observedAt:past,effectiveAt:past,verified:true,...extra});
const edge=(from,to,extra={})=>({from,to,relation:'PARENT_OF',source:'fixture://'+from+'-'+to,observedAt:past,effectiveAt:past,verified:true,data:{},...extra});
const base=()=>createTwinRevision({tenant:'alpha',nodes:[node('org','tenant',{globalContext:{countryCode:'GB',locale:'en-GB',timeZone:'Europe/London',currency:'GBP',unitSystem:'metric'}}),node('legal','legal-entity',{globalContext:{dataRegion:'eu'}}),node('site','site',{globalContext:{currency:'EUR'}})],edges:[edge('org','legal'),edge('legal','site')]});
const query=(revision=base(),extra={})=>projectSiteOperatingContext({revision,tenant:'alpha',siteId:'site',knownAt:at,effectiveAt:at,...extra});
const changed=(edit)=>{const r=base();edit(r);return createTwinRevision(r);};
test('inherited display context is detached, field-provenanced and has no policy authority',()=>{const r=base(),p=query(r);assert.deepEqual(p.lineage,['org','legal','site']);assert.deepEqual(p.context,{countryCode:'GB',locale:'en-GB',timeZone:'Europe/London',currency:'EUR',unitSystem:'metric',dataRegion:'eu'});assert.equal(p.fieldProvenance.currency.nodeId,'site');assert.equal(p.fieldProvenance.timeZone.source,'fixture://org');assert.equal(p.executionAuthority,false);assert.equal(p.customerMutation,false);assert.equal(p.revision,r.revision);assert.equal(p.policyContext,null);assert.equal(typeof p.effectivePolicies,'undefined');r.nodes.find(x=>x.id==='site').data.globalContext.currency='USD';assert.equal(p.context.currency,'EUR');assert.throws(()=>{p.fieldProvenance.currency.source='evil';},TypeError);});
test('future parent knowledge cannot enter earlier site context',()=>{const r=changed(r=>{r.nodes.find(x=>x.id==='org').observedAt='2026-10-10T00:00:00.000Z';r.edges.find(x=>x.from==='org').observedAt='2026-10-10T00:00:00.000Z';});const p=query(r);assert.deepEqual(p.lineage,['legal','site']);assert.equal(p.context.countryCode,undefined);assert.equal(p.context.currency,'EUR');assert.deepEqual(p.missingFields,['countryCode','timeZone']);});
test('future effective parents cannot enter earlier site context',()=>{const r=changed(r=>r.edges.find(x=>x.from==='org').effectiveAt='2026-10-10T00:00:00.000Z');assert.equal(query(r).context.timeZone,undefined);});
test('selected unverified context and unverified hierarchy fail closed',()=>{assert.throws(()=>query(changed(r=>r.nodes.find(x=>x.id==='org').verified=false)),/verified/);assert.throws(()=>query(changed(r=>r.edges[0].verified=false)),/verified/);});
test('half-open parent validity permits successive parents, never overlap by list order',()=>{const r=base();r.nodes.push(node('old','tenant',{globalContext:{currency:'USD'}}));r.edges[0].data.validFrom=at;r.edges.push(edge('old','legal',{data:{validTo:at}}));assert.equal(query(createTwinRevision(r)).fieldProvenance.countryCode.nodeId,'org');r.edges.at(-1).data.validTo='2026-10-03T00:00:00.000Z';assert.throws(()=>query(createTwinRevision(r)),/ambiguous/);});
test('hierarchy cycles fail closed',()=>{const r=base();r.edges.push(edge('site','org'));assert.throws(()=>query(createTwinRevision(r)),/cycle/);});
test('nonorganisation parent type cannot provide display context',()=>{const r=changed(r=>r.nodes.find(x=>x.id==='org').type='policy');assert.throws(()=>query(r),/organisation/);});
test('wrong tenant, node/edge tenant tampering and revision mutation rejected',()=>{assert.throws(()=>query(base(),{tenant:'bravo'}),/tenant/);for(const collection of ['nodes','edges']){const r=base();r[collection][0].tenant='bravo';r.revision=digest({tenant:r.tenant,nodes:r.nodes,edges:r.edges});assert.throws(()=>query(r),/tenant/);}const r=base();r.nodes[0].data.globalContext.currency='JPY';assert.throws(()=>query(r),/revision/);});
test('claimed revision cannot hide raw payload changes behind canonical normalization',()=>{const r=base();r.nodes.find(x=>x.id==='org').id=' org ';assert.throws(()=>query(r),/canonical.*payload|revision/);});
test('site identity is required, must exist, be a site and known/effective at query',()=>{assert.throws(()=>query(base(),{siteId:'missing'}),/site/);assert.throws(()=>query(base(),{siteId:'org'}),/site/);assert.throws(()=>query(changed(r=>r.nodes.find(x=>x.id==='site').observedAt='2026-10-10T00:00:00.000Z')),/site.*time/);});
test('invalid display fields rejected rather than silently normalized into authority',()=>{for(const [field,value]of Object.entries({countryCode:'GBA',locale:'invalid_locale',timeZone:'Mars/Olympus',currency:'eur',unitSystem:'custom',dataRegion:''})){assert.throws(()=>query(changed(r=>{r.nodes.find(x=>x.id==='site').data.globalContext[field]=value;})),new RegExp(field));}});
test('unknown policy-like fields are not inherited',()=>{const p=query(changed(r=>r.nodes[0].data.globalContext.workingTimeMaximum=60));assert.equal(p.context.workingTimeMaximum,undefined);assert.equal(p.policyContext,null);});
test('explicit UTC timestamps are strict, require actual calendar instants and no implicit clock',()=>{for(const bad of [undefined,'2026-02-30T00:00:00Z','2026-10-02','2026-10-02T00:00:00+01:00','not-date'])assert.throws(()=>query(base(),{knownAt:bad}),/knownAt/);assert.throws(()=>query(changed(r=>r.edges[0].data.validTo='2026-02-30T00:00:00Z')),/validTo/);});
test('DST and opposite offset sites format verified local civil time from explicit instants',()=>{const p=query();assert.equal(p.localParts('2026-03-29T00:30:00.000Z').hour,'00');assert.equal(p.localParts('2026-03-29T01:30:00.000Z').hour,'02');const tokyo=query(changed(r=>r.nodes.find(x=>x.id==='site').data.globalContext.timeZone='Asia/Tokyo'));assert.equal(tokyo.localParts('2026-10-02T16:00:00Z').day,'03');assert.equal(tokyo.localParts('2026-10-02T16:00:00Z').hour,'01');assert.throws(()=>p.localParts('2026-02-30T00:00:00Z'),/instant/);});
test('missing timezone is explicit and cannot format by guessing',()=>{const r=base();r.nodes.forEach(x=>delete x.data.globalContext?.timeZone);const p=query(createTwinRevision(r));assert.deepEqual(p.missingFields,['timeZone']);assert.throws(()=>p.localParts(at),/timeZone/);});
module.exports={base,query,node,edge,at,past};
