{
  "schemaVersion": 1,
  "profiles": [
    {
      "id": "rest-openapi",
      "matches": [
        "REST",
        "OpenAPI",
        "OpenAPI 2/3",
        "OpenAPI 3",
        "OpenAPI 3+",
        "OpenAPI 3.1",
        "JSON-2",
        "REST-via-gateways"
      ],
      "transport": "HTTPS",
      "adapter": "http-json",
      "supports": [
        "pull",
        "push",
        "webhook"
      ],
      "notes": "Preferred cloud API family; import OpenAPI where available. JSON-2 is treated as an HTTP/JSON specialization, not as evidence of generic REST semantics."
    },
    {
      "id": "odata",
      "matches": [
        "OData",
        "OData 2/4",
        "OData-query"
      ],
      "transport": "HTTPS",
      "adapter": "odata",
      "supports": [
        "metadata",
        "query",
        "pull",
        "push"
      ],
      "notes": "Use $metadata and server-side query/filter/paging."
    },
    {
      "id": "soap",
      "matches": [
        "SOAP",
        "SOAP 1.1/1.2",
        "XML Web Services"
      ],
      "transport": "HTTPS",
      "adapter": "soap-wsdl",
      "supports": [
        "pull",
        "push"
      ],
      "notes": "Generate operations from WSDL; preserve vendor namespaces and vendor deprecation timelines."
    },
    {
      "id": "graphql",
      "matches": [
        "GraphQL"
      ],
      "transport": "HTTPS",
      "adapter": "graphql",
      "supports": [
        "query",
        "mutation",
        "subscription"
      ],
      "notes": "Introspection only where vendor allows it."
    },
    {
      "id": "scim",
      "matches": [
        "SCIM",
        "SCIM 2.0"
      ],
      "transport": "HTTPS",
      "adapter": "scim2",
      "supports": [
        "users",
        "groups",
        "provisioning"
      ],
      "notes": "Identity lifecycle/provisioning."
    },
    {
      "id": "webhooks-events",
      "matches": [
        "webhooks",
        "events",
        "notifications",
        "Atom feeds"
      ],
      "transport": "HTTPS",
      "adapter": "signed-events",
      "supports": [
        "inbound-events",
        "replay",
        "dedupe"
      ],
      "notes": "Verify signatures where vendor provides them; otherwise validate source/auth and replay bounds."
    },
    {
      "id": "files-sftp",
      "matches": [
        "SFTP",
        "files"
      ],
      "transport": "SFTP/Object storage",
      "adapter": "file-batch",
      "supports": [
        "csv",
        "json",
        "xml",
        "fixed-width"
      ],
      "notes": "Checksum, idempotency, quarantine, schema validation."
    },
    {
      "id": "database",
      "matches": [
        "database",
        "JDBC/ODBC"
      ],
      "transport": "DB",
      "adapter": "database-readmodel",
      "supports": [
        "read",
        "cdc-when-supported"
      ],
      "notes": "Prefer read replicas/views; direct writes disabled by default."
    },
    {
      "id": "opcua",
      "matches": [
        "OPC UA"
      ],
      "transport": "OPC UA",
      "adapter": "opcua-edge",
      "supports": [
        "browse",
        "subscribe",
        "read",
        "write-gated"
      ],
      "notes": "Edge gateway preferred for plant networks."
    },
    {
      "id": "mqtt",
      "matches": [
        "MQTT",
        "Sparkplug B"
      ],
      "transport": "MQTT/TLS",
      "adapter": "mqtt-edge",
      "supports": [
        "subscribe",
        "publish-gated"
      ],
      "notes": "Support topic mapping and Sparkplug B profile where present."
    },
    {
      "id": "bacnet",
      "matches": [
        "BACnet"
      ],
      "transport": "BACnet/IP via edge",
      "adapter": "bacnet-edge",
      "supports": [
        "read",
        "subscribe"
      ],
      "notes": "Energy/BMS telemetry via site edge; cloud should not directly scan plant networks."
    },
    {
      "id": "modbus",
      "matches": [
        "Modbus"
      ],
      "transport": "Modbus TCP/RTU via edge",
      "adapter": "modbus-edge",
      "supports": [
        "read"
      ],
      "notes": "Read-only by default; register maps must be customer/site supplied."
    },
    {
      "id": "edi",
      "matches": [
        "EDI",
        "EDI/AS2",
        "AS2"
      ],
      "transport": "AS2/SFTP/VAN",
      "adapter": "edi-b2b",
      "supports": [
        "inbound",
        "outbound-gated"
      ],
      "notes": "Translate messages to canonical WFM/supply-chain events only where relevant."
    },
    {
      "id": "kafka",
      "matches": [
        "Kafka",
        "Kafka protocol"
      ],
      "transport": "Kafka",
      "adapter": "event-stream",
      "supports": [
        "consume",
        "produce-gated"
      ],
      "notes": "Schema registry integration where available."
    },
    {
      "id": "amqp",
      "matches": [
        "AMQP",
        "AMQP 1.0"
      ],
      "transport": "AMQP/TLS",
      "adapter": "message-bus",
      "supports": [
        "consume",
        "publish-gated",
        "settlement"
      ],
      "notes": "Use standards-compliant AMQP 1.0 clients. Do not infer compatibility with retired vendor protocols such as Azure Service Bus SBMP."
    },
    {
      "id": "protobuf-rpc-http2",
      "matches": [
        "Protobuf RPC/HTTP2"
      ],
      "transport": "HTTPS/HTTP2",
      "adapter": "protobuf-rpc",
      "supports": [
        "query",
        "list",
        "events",
        "mutation-gated"
      ],
      "notes": "Generate or use vendor-supported clients from Protocol Buffers definitions where available; preserve vendor status/error semantics and default to read-only methods."
    },
    {
      "id": "schema-registry",
      "matches": [
        "Schema Registry"
      ],
      "transport": "HTTPS",
      "adapter": "schema-registry",
      "supports": [
        "read",
        "compatibility-check",
        "write-gated"
      ],
      "notes": "Keep registry credentials separate from broker credentials where the provider scopes them independently."
    },
    {
      "id": "legacy-rpc",
      "matches": [
        "JSON-RPC",
        "XML-RPC"
      ],
      "transport": "HTTPS",
      "adapter": "legacy-rpc",
      "supports": [
        "pull",
        "push-gated"
      ],
      "notes": "Migration-only profile for legacy RPC surfaces. Prefer the vendor's current HTTP API for new integrations and enforce published removal timelines."
    },
    {
      "id": "vendor-sdk",
      "matches": [
        "SDK",
        "Web SDK",
        "Salesforce APIs",
        "Service Layer",
        "ION",
        "HCM Data Loader",
        "IDoc",
        "industrial-integration",
        "industrial-protocols",
        "Cloud API Gateway",
        "connectors",
        "REST-via-modules",
        "OData-query",
        "PI Web API",
        "OPC UA-via-Kepware",
        "MQTT",
        "Microsoft Graph",
        "Admin SDK",
        "XML Web Services"
      ],
      "transport": "vendor-defined",
      "adapter": "vendor-thin",
      "supports": [
        "vendor-defined"
      ],
      "notes": "Thin adapter; fall back to standard protocol profile whenever possible."
    }
  ]
}
