FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96
WORKDIR /proof
RUN apt-get update && apt-get install -y --no-install-recommends chromium && rm -rf /var/lib/apt/lists/*
COPY . ./
RUN npm ci --prefix security/runtime --omit=dev --ignore-scripts --no-audit --no-fund
RUN node --test scripts/navigation-response-completion.test.mjs scripts/navigation-response-contract.test.mjs scripts/rendered-role-assertions.test.mjs
RUN node --test verification/provider-recovery-correction/tests/support-recovery-lifecycle.test.cjs verification/provider-recovery-correction/tests/support-recovery-ui.test.cjs verification/provider-recovery-correction/tests/support-ui-composition.test.cjs ux-overlay/vector-action-queue.test.cjs ux-overlay/vector-demand-intelligence.test.cjs tests/vector-consolidation.test.cjs scripts/compose-vector-local-runtime.contract.test.cjs
RUN node scripts/compose-vector-local-runtime.mjs /tmp/vector-composed
RUN for attempt in 1 2 3; do WFM_SUPPORT_HTTP_RUNTIME=/tmp/vector-composed WFM_SUPPORT_HTTP_HARNESS=/proof/verification/vector-repair-20260921/attendance-runtime-harness.mjs node --test verification/provider-recovery-correction/tests/support-recovery-http.test.cjs || exit $?; done
