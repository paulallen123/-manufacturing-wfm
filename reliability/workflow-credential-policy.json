{
  "schema_version": 1,
  "updated": "2026-09-18",
  "purpose": "Declarative allowlist for every GitHub Actions workflow permitted to consume a repository/provider credential. Any secret-bearing workflow not declared here fails closed.",
  "defaults": {
    "owner_only": true,
    "runner": "ubuntu-24.04",
    "contents_permission": "read",
    "secret_must_be_step_scoped_env": true,
    "secret_reference_count": 1
  },
  "workflows": [
    {
      "path": ".github/workflows/railway-first-deploy.yml",
      "secret": "RAILWAY_TOKEN",
      "browser_credential": false,
      "required_text": [
        "if: github.actor == github.repository_owner",
        "runs-on: ubuntu-24.04",
        "contents: read",
        "persist-credentials: false",
        "RAILWAY_PROJECT_ID: '9a774359-37fa-47e8-bde0-932420c32923'",
        "RAILWAY_ENVIRONMENT_ID: '6a33f2c1-bedd-46dc-85e7-2ef5d3b54de6'",
        "RAILWAY_SERVICE_ID: 'ddd54fb9-3564-4251-9959-28cf3308c272'",
        "EXPECTED_RUNTIME_SHA256: '3ca08429d1b8dc9e9f604f0414865d41ff871c07bdf76f0a1c84541ab7f27f4d'"
      ]
    },
    {
      "path": ".github/workflows/live-browser-readonly-proof.yml",
      "secret": "WFM_DEMO_PASSWORD",
      "browser_credential": true,
      "required_text": [
        "if: github.actor == github.repository_owner",
        "runs-on: ubuntu-24.04",
        "contents: read",
        "persist-credentials: false"
      ],
      "preflight": "node scripts/browser-security-floor.mjs"
    },
    {
      "path": ".github/workflows/live-host-tenant-isolation-proof.yml",
      "secret": "WFM_DEMO_PASSWORD",
      "browser_credential": true,
      "required_text": [
        "if: github.actor == github.repository_owner",
        "runs-on: ubuntu-24.04",
        "contents: read",
        "persist-credentials: false"
      ],
      "preflight": "node scripts/browser-security-floor.mjs"
    }
  ],
  "invariants": [
    "A credential-bearing workflow must be explicitly declared before it can pass the repository security gate.",
    "Each declared workflow may consume only its named credential and exactly once.",
    "Credential material must exist only in the env block of one named step.",
    "Browser-relevant credentials may not be made available to a step until the shared browser security-floor preflight has passed.",
    "Adding a new credential-bearing workflow is a security-policy change, not an ordinary test-workflow change."
  ]
}
