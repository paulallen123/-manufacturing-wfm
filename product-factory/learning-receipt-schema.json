{
  "schemaVersion": 1,
  "recordType": "vector-learning-receipt",
  "required": [
    "learningId",
    "tenantScope",
    "sourceEvidence",
    "baselineVersion",
    "candidateVersion",
    "hypothesis",
    "evalSetVersion",
    "holdoutResult",
    "safetyResult",
    "decision",
    "rollbackRef",
    "createdAt"
  ],
  "decisionValues": [
    "reject",
    "retain-shadow",
    "canary",
    "promote",
    "rollback"
  ],
  "prohibited": [
    "raw-secret",
    "unscoped-cross-tenant-memory",
    "direct-execution-token",
    "unsigned-production-authority"
  ]
}
