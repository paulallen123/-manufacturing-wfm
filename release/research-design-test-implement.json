{
  "schemaVersion": 1,
  "contract": "VECTOR_RESEARCH_DESIGN_TEST_IMPLEMENT_V1",
  "purpose": "Guarantee that every research finding and prototype is designed, falsifiably theory-tested, safely implemented through an existing canonical owner, and then proved into FORGE or retained with an explicit resolution route.",
  "invariants": {
    "noSeventhLoop": true,
    "noResearchLoss": true,
    "designBeforeTheoryTest": true,
    "theoryTestBeforeImplementation": true,
    "implementationBeforeConvergenceProof": true,
    "failedTheoryIsRetainedNotDropped": true,
    "canonicalOwnerReuseRequired": true,
    "duplicateSourceOfTruthForbidden": true,
    "securityAuthorityTenantPayrollEvidenceGatesMayNotWeaken": true,
    "goldenJourneyPriorityPreserved": true,
    "prototypeOrSimulationNeverCountsAsHostedProductionProof": true
  },
  "deliveryStages": ["DESIGN","THEORY_TEST","IMPLEMENTATION","CONVERGENCE_PROOF","CONVERGED"],
  "stageGates": {
    "DESIGN": {
      "required": ["customer-problem","hypothesis","canonical-owner","evidence-inputs","failure-modes","security-authority-boundaries","rollback-or-safe-abstention","non-goals","value-metric"],
      "exit": "Design review identifies an additive route into existing VECTOR owners with no duplicate product, loop or source of truth."
    },
    "THEORY_TEST": {
      "required": ["baseline","counterfactual","falsification-criteria","normal-scenario","edge-scenario","adversarial-scenario","no-customer-mutation"],
      "exit": "Theory survives falsification criteria or remains registered with a redesign/evidence route."
    },
    "IMPLEMENTATION": {
      "required": ["reuse-canonical-owner","tenant-isolation","rollback","security-authority-boundary","unit-test","adversarial-test","observability"],
      "highImpactRule": "Country policy, payroll, scheduling, identity, security and machine-control capabilities must begin advisory/read-only or pass independent authority gates.",
      "exit": "Isolated implementation passes source-level and adversarial gates without weakening the canonical product."
    },
    "CONVERGENCE_PROOF": {
      "required": ["exact-image","hosted-runtime","role-journey","persistence-or-readback","rollback-or-safe-abstention","value-evidence","superset-proof"],
      "exit": "Capability can enter canonical FORGE without regression or unsupported claims."
    },
    "CONVERGED": {
      "required": ["canonical-owner","ongoing-regression","outcome-measurement"],
      "exit": "Remain in FORGE and continue measuring/evolving; retirement requires stronger superset proof."
    }
  },
  "engines": {
    "orchestrator": {"responsibilities": ["register every research item","deduplicate","assign existing engine owners","prioritise by customer value and weakest proof","prevent lifecycle loss","keep Golden Journey priority"]},
    "product-evolution": {"responsibilities": ["design contract","customer-value metric","reuse/superset decision","implementation candidate","before/after comparison"]},
    "frontier-cross-domain-innovation": {"responsibilities": ["cross-domain hypothesis","novelty check","theory simulation","counterfactual","adversarial/failure attack","falsify before build"]},
    "integration-data-fabric": {"responsibilities": ["source feasibility","schema/provenance","provider constraints","country/regional policy evidence","live-data route","reconciliation"]},
    "autonomous-implementation-support": {"responsibilities": ["implementation effort removal","migration/backfill","training/support impact","recovery/runbook","zero-human route"]},
    "trust-proof-release": {"responsibilities": ["authority/security/tenant review","proof design","exact-image","hosted proof","Golden Journey","rollback","superset/retirement gate"]}
  },
  "requiredSequence": ["register","design","theory-test","falsify-or-retain","implement-isolated","adversarial-test","exact-proof","converge","measure-outcome","evolve"]
}
