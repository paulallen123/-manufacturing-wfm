{
  "schemaVersion": 2,
  "name": "VECTOR_PROOF_LANE_INDEPENDENCE_V2",
  "principle": "Development and testing continue through an equivalent executable lane when a provider is unavailable. A fallback must preserve exact candidate identity and the required proof scope; weaker evidence never substitutes for stronger proof.",
  "states": {
    "providerUnavailable": "PROVIDER_DEGRADED",
    "noRunner": "PROVIDER_DEGRADED",
    "skipped": "NO_PROOF",
    "productGateFailure": "PRODUCT_FAILURE",
    "exactPass": "PASS"
  },
  "rules": {
    "neverSkipTestsToUnblock": true,
    "skippedNeverCountsAsPass": true,
    "noRunnerNeverCountsAsProductFailure": true,
    "providerFailureNeverCountsAsPass": true,
    "exactSourceShaRequired": true,
    "immutableEvidenceRequired": true,
    "developmentContinuesIfAnyExecutableLaneExists": true,
    "productionPromotionRequiresIndependentProviders": 2,
    "fallbackMustMatchRequiredProofScopes": true,
    "weakerLaneMayNotSubstituteForStrongerProof": true,
    "uncoveredRequiredScopeRemainsBlocked": true,
    "deploymentSuccessNeverCountsAsHostedPass": true,
    "publicIngressVerificationRequired": true,
    "applicationIdentityVerificationRequired": true,
    "proofLinkMayBeSharedOnlyAfterPublicVerification": true
  },
  "lanes": [
    {
      "id": "github-actions-ui",
      "provider": "github-actions",
      "class": "supplemental",
      "exactSourceSha": true,
      "requiredForDevelopment": false,
      "requiredForPromotion": false,
      "sourceBinding": "must-match-candidate-sha",
      "proofScopes": [
        "supplemental-status"
      ],
      "runtimeMode": "none"
    },
    {
      "id": "circleci-core",
      "provider": "circleci",
      "class": "source-proof",
      "exactSourceSha": true,
      "requiredForDevelopment": false,
      "requiredForPromotion": true,
      "sourceBinding": "must-match-candidate-sha",
      "proofScopes": [
        "source-contracts",
        "preflight",
        "semantic-continuity"
      ],
      "runtimeMode": "source"
    },
    {
      "id": "circleci-runtime",
      "provider": "circleci",
      "class": "exact-image",
      "exactSourceSha": true,
      "requiredForDevelopment": false,
      "requiredForPromotion": true,
      "sourceBinding": "must-match-candidate-sha",
      "proofScopes": [
        "source-contracts",
        "preflight",
        "semantic-continuity",
        "exact-image",
        "runtime-security",
        "hosted-http-boundary"
      ],
      "runtimeMode": "product-runtime"
    },
    {
      "id": "railway-forge-candidate",
      "provider": "railway",
      "class": "exact-image",
      "exactSourceSha": true,
      "watchPattern": "**",
      "requiredForDevelopment": false,
      "requiredForPromotion": true,
      "sourceBinding": "must-match-candidate-sha",
      "proofScopes": [
        "source-contracts",
        "preflight",
        "semantic-continuity",
        "exact-image",
        "hosted-product-runtime",
        "hosted-healthcheck",
        "public-ingress-2xx",
        "application-identity"
      ],
      "runtimeMode": "product-runtime"
    },
    {
      "id": "railway-forge-current-proof",
      "provider": "railway",
      "class": "exact-image",
      "exactSourceSha": true,
      "watchPattern": "**",
      "requiredForDevelopment": false,
      "requiredForPromotion": true,
      "sourceBinding": "must-match-candidate-sha",
      "proofScopes": [
        "source-contracts",
        "preflight",
        "semantic-continuity",
        "exact-image",
        "docker-admission"
      ],
      "runtimeMode": "proof-stub"
    }
  ],
  "fallbackOrder": [
    "railway-forge-current-proof",
    "circleci-runtime",
    "railway-forge-candidate",
    "circleci-core",
    "github-actions-ui"
  ],
  "developmentRule": "A broken provider changes the lane state, not the product-development state. Continue coding and reroute the same immutable candidate only to a lane that proves every required scope; otherwise keep that scope explicitly blocked while unrelated development continues.",
  "promotionRule": "Promote only when required proof scopes are satisfied by SHA-bound evidence and independent providers meet the promotion rule. A source-only, proof-stub or supplemental lane cannot stand in for hosted product runtime proof. Railway deployment SUCCESS alone is DEPLOYED_UNVERIFIED; hosted proof additionally requires external public-ingress 2xx and the expected application identity marker."
}
