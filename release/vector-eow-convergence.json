    "antiPatterns": [
      "duplicate screens",
      "different navigation labels rendering the same experience",
      "metrics without an action",
      "graphs without source data",
      "AI output without authority or provenance",
      "features exposed before their journey is complete"
    ]
  },
  "customerDemandIntelligence": {
