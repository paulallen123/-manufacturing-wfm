{
  "schemaVersion": 1,
  "name": "VECTOR_T9_CONTINUOUS_CUSTOMER_GUARDIAN_V1",
  "customerPromise": {
    "simulationInvisible": true,
    "simulationOffCriticalResponsePath": true,
    "noRequestBodiesStored": true,
    "noSecretsOrCookiesStored": true,
    "noProductionMutationFromSimulation": true,
    "noSimulationResultMayCountAsProof": true
  },
  "remediation": {
    "everyFindingRemainsOpenUntilVerified": true,
    "autoFixRequiresCertifiedSafeRemediator": true,
    "repairActorAndVerifierMustBeDistinct": true,
    "unknownsCannotAutoFix": true,
    "failedVerificationRequiresRollbackOrContainment": true,
    "unresolvedFindingBlocksOnlyAffectedScopePromotion": true,
    "unresolvedFindingNeverStopsUnrelatedDevelopment": true
  },
  "evolution": {
    "repeatedFailurePatternsBecomeScenarioCandidates": true,
    "scenarioCandidatesAreProposalOnly": true,
    "newScenariosRequireIsolatedReproduction": true,
    "promotionRequiresIndependentEvidence": true,
    "authorityMayNeverSelfExpand": true
  },
  "safety": {
    "safetyLeverRequired": true,
    "boundedQueue": true,
    "highRiskPreservedUnderBackpressure": true
  },
  "lifecycle": [
    "observe",
    "shadow-rehearse",
    "predict",
    "detect",
    "classify",
    "safe-repair-or-contain",
    "independently-verify",
    "measure",
    "learn",
    "add-permanent-guard",
    "rehearse-again"
  ]
}
