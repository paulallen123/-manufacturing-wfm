CMD ["node","-e","const z=require('/app/trust/runtime/vector-zero-human-governance.cjs');const meta=require('/app/product-factory/vector-meta-loop-policy.json');if(typeof z.decideZeroHumanAction!=='function'||typeof z.evaluateHumanTouchReleaseGate!=='function'||meta.contract!=='VECTOR_META_LOOP_V1')throw new Error('FRONTIER_RUNTIME_IMPORT_PROOF_FAILED');require('node:http').createServer((req,res)=>{res.writeHead(200,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify({status:'FRONTIER_PROOF_BUILT',contract:'VECTOR_FRONTIER_CONVERGENCE_V1',engineeringPlane:'VECTOR_ENGINEERING_PLANE_V1',toolFoundry:'SHADOW_PROVEN',learningBridge:'GOVERNED_PROPOSAL_ONLY',zeroHumanGovernance:z.decideZeroHumanAction({}).contractVersion,metaLoop:meta.contract}))}).listen(Number(process.env.PORT||3000),'0.0.0.0')"]
