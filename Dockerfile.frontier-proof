FROM node:22.23.2-bookworm-slim@sha256:4d676821dff059fd00d277ee4261ef34ea712317fed0737c03941481b5760c96

WORKDIR /app

RUN mkdir -p /app/operations/runtime /app/trust/runtime /app/engineering/runtime /app/release /app/scripts

COPY operations/runtime/decision-episode.cjs /app/operations/runtime/decision-episode.cjs
COPY operations/runtime/frontier-decision-control.cjs /app/operations/runtime/frontier-decision-control.cjs
COPY operations/runtime/autopilot-execution-engine.cjs /app/operations/runtime/autopilot-execution-engine.cjs
COPY operations/runtime/golden-industrial-loop.cjs /app/operations/runtime/golden-industrial-loop.cjs
COPY operations/runtime/decision-outcome-proof.cjs /app/operations/runtime/decision-outcome-proof.cjs
COPY operations/runtime/frontier-outcome-learning.cjs /app/operations/runtime/frontier-outcome-learning.cjs
COPY trust/runtime/vector-trust-spine.cjs /app/trust/runtime/vector-trust-spine.cjs
COPY engineering/runtime/vector-tool-foundry.cjs /app/engineering/runtime/vector-tool-foundry.cjs
COPY engineering/runtime/vector-tool-builtins.cjs /app/engineering/runtime/vector-tool-builtins.cjs
COPY release/vector-frontier-convergence.json /app/release/vector-frontier-convergence.json
COPY release/vector-engineering-plane.json /app/release/vector-engineering-plane.json
COPY scripts/run-vector-foundry-proof.mjs /app/scripts/run-vector-foundry-proof.mjs

# Build admission runs against the exact runtime paths. Test files are copied beside
# those runtime modules only for the admission step and are then removed.
COPY operations/runtime/frontier-decision-control.test.cjs /app/operations/runtime/frontier-decision-control.test.cjs
COPY operations/runtime/autopilot-execution-engine.test.cjs /app/operations/runtime/autopilot-execution-engine.test.cjs
COPY operations/runtime/golden-industrial-loop.test.cjs /app/operations/runtime/golden-industrial-loop.test.cjs
COPY operations/runtime/frontier-outcome-learning.test.cjs /app/operations/runtime/frontier-outcome-learning.test.cjs
COPY trust/runtime/vector-trust-spine.test.cjs /app/trust/runtime/vector-trust-spine.test.cjs
COPY engineering/runtime/vector-tool-foundry.test.cjs /app/engineering/runtime/vector-tool-foundry.test.cjs

RUN node --check /app/operations/runtime/decision-episode.cjs \
 && node --check /app/operations/runtime/frontier-decision-control.cjs \
 && node --check /app/operations/runtime/autopilot-execution-engine.cjs \
 && node --check /app/operations/runtime/golden-industrial-loop.cjs \
 && node --check /app/operations/runtime/decision-outcome-proof.cjs \
 && node --check /app/operations/runtime/frontier-outcome-learning.cjs \
 && node --check /app/trust/runtime/vector-trust-spine.cjs \
 && node --check /app/engineering/runtime/vector-tool-foundry.cjs \
 && node --check /app/engineering/runtime/vector-tool-builtins.cjs \
 && node --check /app/scripts/run-vector-foundry-proof.mjs \
 && node --test \
      /app/operations/runtime/frontier-decision-control.test.cjs \
      /app/operations/runtime/autopilot-execution-engine.test.cjs \
      /app/operations/runtime/golden-industrial-loop.test.cjs \
      /app/operations/runtime/frontier-outcome-learning.test.cjs \
      /app/trust/runtime/vector-trust-spine.test.cjs \
      /app/engineering/runtime/vector-tool-foundry.test.cjs \
 && node /app/scripts/run-vector-foundry-proof.mjs \
 && node -e "const f=require('/app/operations/runtime/frontier-decision-control.cjs');const a=require('/app/operations/runtime/autopilot-execution-engine.cjs');const g=require('/app/operations/runtime/golden-industrial-loop.cjs');const l=require('/app/operations/runtime/frontier-outcome-learning.cjs');const t=require('/app/trust/runtime/vector-trust-spine.cjs');const e=require('/app/engineering/runtime/vector-tool-foundry.cjs');if(typeof f.createAssuranceEnvelope!=='function'||typeof f.validateAssuranceEnvelope!=='function'||typeof a.createAutopilotExecutionEngine!=='function'||typeof g.buildGoldenIndustrialLoop!=='function'||typeof l.assessGoldenCausalPromotion!=='function'||typeof t.EvidenceLedger!=='function'||typeof e.VectorToolFoundry!=='function')throw new Error('FRONTIER_RUNTIME_IMPORT_PROOF_FAILED');console.log('FRONTIER_RUNTIME_IMPORT_PROOF=PASS')" \
 && rm -f \
      /app/operations/runtime/frontier-decision-control.test.cjs \
      /app/operations/runtime/autopilot-execution-engine.test.cjs \
      /app/operations/runtime/golden-industrial-loop.test.cjs \
      /app/operations/runtime/frontier-outcome-learning.test.cjs \
      /app/trust/runtime/vector-trust-spine.test.cjs \
      /app/engineering/runtime/vector-tool-foundry.test.cjs

RUN chown -R root:root /app \
 && find /app -type d -exec chmod 0555 {} + \
 && find /app -type f -exec chmod 0444 {} +

USER node
ENV NODE_ENV=staging
EXPOSE 3000

CMD ["node","-e","require('node:http').createServer((req,res)=>{res.writeHead(200,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify({status:'FRONTIER_PROOF_BUILT',contract:'VECTOR_FRONTIER_CONVERGENCE_V1',engineeringPlane:'VECTOR_ENGINEERING_PLANE_V1',toolFoundry:'SHADOW_PROVEN'}))}).listen(Number(process.env.PORT||3000),'0.0.0.0')"]
