FROM node:22.23.2-bookworm-slim
WORKDIR /proof
COPY scripts/proof-runner-auth.mjs /proof/proof-runner-auth.mjs
COPY scripts/passwordless-proof-smoke.mjs /proof/passwordless-proof-smoke.mjs
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
          /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/pnpm /usr/local/bin/pnpx \
 && chown -R root:root /proof \
 && find /proof -type d -exec chmod 0555 {} + \
 && find /proof -type f -exec chmod 0444 {} +
USER node
CMD ["node","/proof/passwordless-proof-smoke.mjs"]
