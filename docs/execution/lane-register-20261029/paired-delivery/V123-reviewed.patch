diff --git a/adaptive-intelligence/durable-outcome-ledger.mjs b/adaptive-intelligence/durable-outcome-ledger.mjs
new file mode 100644
index 0000000..5ddba4b
--- /dev/null
+++ b/adaptive-intelligence/durable-outcome-ledger.mjs
@@ -0,0 +1,71 @@
+import { DatabaseSync } from 'node:sqlite';
+import { AdaptiveIntelligenceEngine } from './engine.mjs';
+
+// Narrow, synchronous replay ledger for an approved local SQLite state path.
+// The caller still owns source authentication, tenant binding and volume custody.
+const columns=['tenantScope','source','category','fingerprint','evidenceRef'];
+function normalize(input){
+  if(!input||typeof input!=='object'||(Object.getPrototypeOf(input)!==Object.prototype&&Object.getPrototypeOf(input)!==null)) throw new Error('OUTCOME_INERT_RECORD_REQUIRED');
+  if(Reflect.ownKeys(input).some(key=>typeof key!=='string'||!Object.getOwnPropertyDescriptor(input,key)?.enumerable||!('value' in Object.getOwnPropertyDescriptor(input,key)))) throw new Error('OUTCOME_INERT_RECORD_REQUIRED');
+  for(const key of columns) if(typeof input[key]!=='string'||!input[key].trim()||input[key].length>512) throw new Error('OUTCOME_STABLE_'+key+'_REQUIRED');
+  if(typeof input.baseline!=='number'||!Number.isFinite(input.baseline)||typeof input.result!=='number'||!Number.isFinite(input.result)) throw new Error('OUTCOME_FINITE_VALUES_REQUIRED');
+  if(typeof input.verified!=='boolean') throw new Error('OUTCOME_VERIFIED_BOOLEAN_REQUIRED');
+  if(input.crossTenantRawMemory===true||input.containsSecret===true||input.memoryGrantsAuthority===true) throw new Error('OUTCOME_AUTHORITY_OR_SECRET_FORBIDDEN');
+  if(input.createdAt!==undefined&&(typeof input.createdAt!=='string'||!/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:\.\d+)?Z$/.test(input.createdAt)||!Number.isFinite(Date.parse(input.createdAt)))) throw new Error('OUTCOME_CREATED_AT_INVALID');
+  return {
+    tenantScope:input.tenantScope.trim(),source:input.source.trim(),
+    category:input.category.trim(),fingerprint:input.fingerprint.trim(),
+    baseline:input.baseline,result:input.result,verified:input.verified,
+    evidenceRef:input.evidenceRef.trim(),
+    ...(input.createdAt===undefined?{}:{createdAt:input.createdAt})
+  };
+}
+
+export class DurableOutcomeLedger {
+  #db;
+  #minRepeatedWins;
+  constructor({path,minRepeatedWins=3}={}){
+    if(typeof path!=='string'||!path.trim()||path===':memory:') throw new Error('DURABLE_PATH_REQUIRED');
+    if(!Number.isInteger(minRepeatedWins)||minRepeatedWins<2||minRepeatedWins>1000) throw new Error('LEARNING_THRESHOLD_INVALID');
+    this.#minRepeatedWins=minRepeatedWins;
+    this.#db=new DatabaseSync(path,{timeout:5000});
+    this.#db.exec('PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL; CREATE TABLE IF NOT EXISTS outcome_replay (seq INTEGER PRIMARY KEY, tenant TEXT NOT NULL, source TEXT NOT NULL, evidence TEXT NOT NULL, input_json TEXT NOT NULL, UNIQUE(tenant,source,evidence)); CREATE TABLE IF NOT EXISTS outcome_replay_config (name TEXT PRIMARY KEY, value TEXT NOT NULL);');
+    this.#db.exec('BEGIN IMMEDIATE');
+    try{
+      const stored=this.#db.prepare('SELECT value FROM outcome_replay_config WHERE name=?').get('minRepeatedWins');
+      if(stored&&stored.value!==String(minRepeatedWins)) throw new Error('LEARNING_THRESHOLD_REPLAY_MISMATCH');
+      if(!stored) this.#db.prepare('INSERT INTO outcome_replay_config (name,value) VALUES (?,?)').run('minRepeatedWins',String(minRepeatedWins));
+      this.#db.exec('COMMIT');
+    }catch(error){this.#db.exec('ROLLBACK');this.#db.close();throw error;}
+    this.snapshot(); // fail closed if the existing ledger cannot be replayed
+  }
+  #replay(){
+    const engine=new AdaptiveIntelligenceEngine({minRepeatedWins:this.#minRepeatedWins});
+    for(const {tenant,source,evidence,input_json} of this.#db.prepare('SELECT tenant,source,evidence,input_json FROM outcome_replay ORDER BY seq').all()){
+      const raw=JSON.parse(input_json), input=normalize(raw);
+      if(input.tenantScope!==tenant||input.source!==source||input.evidenceRef!==evidence||!input.createdAt) throw new Error('OUTCOME_REPLAY_ROW_INVALID');
+      engine.ingestOutcome(input);
+    }
+    return engine;
+  }
+  ingestOutcome(raw){
+    const input=normalize(raw);
+    this.#db.exec('BEGIN IMMEDIATE');
+    try{
+      const engine=this.#replay();
+      const receipt=engine.ingestOutcome(input);
+      const existing=this.#db.prepare('SELECT input_json FROM outcome_replay WHERE tenant=? AND source=? AND evidence=?').get(input.tenantScope,input.source,input.evidenceRef);
+      if(!existing){
+        const stored={...input,createdAt:receipt.createdAt};
+        this.#db.prepare('INSERT INTO outcome_replay (tenant,source,evidence,input_json) VALUES (?,?,?,?)').run(input.tenantScope,input.source,input.evidenceRef,JSON.stringify(stored));
+      }
+      this.#db.exec('COMMIT');
+      return receipt;
+    }catch(error){
+      this.#db.exec('ROLLBACK');
+      throw error;
+    }
+  }
+  snapshot(){return this.#replay().snapshot();}
+  close(){this.#db.close();}
+}
diff --git a/adaptive-intelligence/durable-outcome-ledger.test.mjs b/adaptive-intelligence/durable-outcome-ledger.test.mjs
new file mode 100644
index 0000000..08bcb5a
--- /dev/null
+++ b/adaptive-intelligence/durable-outcome-ledger.test.mjs
@@ -0,0 +1,83 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {mkdtempSync,rmSync} from 'node:fs';
+import {tmpdir} from 'node:os';
+import {join} from 'node:path';
+import {DurableOutcomeLedger} from './durable-outcome-ledger.mjs';
+
+const outcome=(n=1,extra={})=>({tenantScope:'t',source:'ledger',category:'scheduling',
+  fingerprint:'cover',baseline:1,result:2,verified:true,evidenceRef:'proof:'+n,...extra});
+function temp(fn){
+  const dir=mkdtempSync(join(tmpdir(),'vector-v123-'));
+  try{return fn(join(dir,'learning.sqlite'));}finally{rmSync(dir,{recursive:true,force:true});}
+}
+
+test('same verified proof remains one win after reopening a durable ledger',()=>temp(path=>{
+  let l=new DurableOutcomeLedger({path});
+  const original=l.ingestOutcome(outcome()); l.close();
+  l=new DurableOutcomeLedger({path});
+  for(let n=0;n<4;n++) assert.deepEqual(l.ingestOutcome(outcome()),original);
+  assert.equal(l.snapshot().outcomes.length,1);
+  assert.equal(l.snapshot().skills.length,0);
+  l.close();
+}));
+
+test('three independently evidenced wins create one advisory candidate across restarts',()=>temp(path=>{
+  for(let n=1;n<=3;n++){const l=new DurableOutcomeLedger({path});l.ingestOutcome(outcome(n));l.close();}
+  const l=new DurableOutcomeLedger({path}), state=l.snapshot();
+  assert.equal(state.outcomes.length,3);
+  assert.equal(state.skills.length,1);
+  assert.equal(state.skills[0].authority,'none');
+  assert.equal(state.skills[0].verifiedWinCount,3);
+  l.close();
+}));
+
+test('conflicting replay rolls back without changing durable state',()=>temp(path=>{
+  let l=new DurableOutcomeLedger({path});
+  const first=l.ingestOutcome(outcome());
+  assert.throws(()=>l.ingestOutcome(outcome(1,{result:4})),/OUTCOME_EVIDENCE_REPLAY_CONFLICT/);
+  l.close();
+  l=new DurableOutcomeLedger({path});
+  assert.deepEqual(l.snapshot().outcomes,[first]);
+  l.close();
+}));
+
+test('two handles observe each committed record rather than stale process memory',()=>temp(path=>{
+  const a=new DurableOutcomeLedger({path}),b=new DurableOutcomeLedger({path});
+  a.ingestOutcome(outcome(1)); b.ingestOutcome(outcome(2)); a.ingestOutcome(outcome(3));
+  assert.equal(b.snapshot().skills[0].verifiedWinCount,3);
+  a.close();b.close();
+}));
+
+test('tenant and source isolate proof identities; unsafe records fail before durable write',()=>temp(path=>{
+  const l=new DurableOutcomeLedger({path});
+  l.ingestOutcome(outcome(1));
+  l.ingestOutcome(outcome(1,{tenantScope:'other'}));
+  l.ingestOutcome(outcome(1,{source:'other'}));
+  assert.throws(()=>l.ingestOutcome(outcome(2,{containsSecret:true})),/OUTCOME_AUTHORITY_OR_SECRET_FORBIDDEN/);
+  assert.throws(()=>l.ingestOutcome(outcome(2,{evidenceRef:' '})),/OUTCOME_STABLE_evidenceRef_REQUIRED/);
+  assert.equal(l.snapshot().outcomes.length,3);
+  l.close();
+}));
+
+test('reopening under a different win threshold fails closed',()=>temp(path=>{
+  const l=new DurableOutcomeLedger({path,minRepeatedWins:4});
+  l.ingestOutcome(outcome(1)); l.close();
+  assert.throws(()=>new DurableOutcomeLedger({path,minRepeatedWins:3}),/LEARNING_THRESHOLD_REPLAY_MISMATCH/);
+  const same=new DurableOutcomeLedger({path,minRepeatedWins:4});
+  assert.equal(same.snapshot().outcomes.length,1);
+  same.close();
+}));
+
+test('derived advisory and regression metadata replays identically after restart',()=>temp(path=>{
+  let l=new DurableOutcomeLedger({path});
+  for(let n=1;n<=3;n++) l.ingestOutcome(outcome(n));
+  l.ingestOutcome(outcome(4,{result:0,fingerprint:'regression'}));
+  const before=l.snapshot();
+  assert.equal(before.skills.length,1);
+  assert.equal(before.evals.length,1);
+  l.close();
+  l=new DurableOutcomeLedger({path});
+  assert.deepEqual(l.snapshot(),before);
+  l.close();
+}));
