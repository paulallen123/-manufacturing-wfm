FROM node:22.23.2-bookworm-slim
WORKDIR /proof

COPY . .

RUN test "$(node --version)" = "v22.23.2" \
 && node scripts/run-zero-cost-ci.mjs

ENV NODE_ENV=production

CMD ["node","-e","const http=require('http'); const payload=JSON.stringify({status:'PASS',proof:'railway-hosted-ci-fallback',sourceSha:process.env.RAILWAY_GIT_COMMIT_SHA||null,claimBoundary:'Hosted source-level validation only; this is not production approval or real-customer evidence.'}); http.createServer((req,res)=>{res.statusCode=200;res.setHeader('content-type','application/json');res.end(payload);}).listen(Number(process.env.PORT||3000),'0.0.0.0');"]
